    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/typescript-config": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "reactotron-react-native": "^5.3.1",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-element-dropdown"
        ],
        "listUnknownPackages": false
      },
      "metroConfigCheck": false
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@xmldom/xmldom@^0.8.0": "^0.8.15",
    "brace-expansion@^2.0.0": "^2.1.7",
    "minimatch@^9.0.0": "^9.0.9",
    "node-forge": "^1.4.3",
    "picomatch@^2.0.0": "^2.3.2",
    "ws@^8.0.0": "^8.22.2",
    "glob@^10.0.0": "^10.5.0"
  }
